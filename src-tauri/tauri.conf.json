{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Boost",
  "version": "0.1.0",
  "identifier": "app.audioboost.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Audio Boost",
        "width": 400,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "nsis", "msi"],
    "category": "AudioVideo",
    "shortDescription": "Volume booster with limiter",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "linux": { "rpm": { "depends": ["pulseaudio-utils"] } }
  }
}
